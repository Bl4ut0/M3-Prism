{
  "name": "m3-prism",
  "version": "1.1.0",
  "description": "M3 Prism: The ultimate multimedia powerhouse. Play any codec, from any platform, in any language.",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"npm --prefix client run dev\" \"electron .\"",
    "start": "electron .",
    "build:client": "npm --prefix client run build",
    "build:portfolios": "node ../scripts/build-portfolios.mjs",
    "build:installer-assets": "node scripts/generate-installer-assets.js",
    "pack": "npm run build:client && npm run build:installer-assets && electron-builder --dir",
    "dist": "npm run build:client && npm run build:installer-assets && electron-builder",
    "release": "node scripts/release.js",
    "clean": "npx rimraf client/dist ../release build"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-only",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.iptv.webplayer",
    "productName": "M3 Prism Desktop",
    "asarUnpack": [
      "server/node_modules/better-sqlite3/**/*"
    ],
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "include": "build/installer.nsh",
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeaderIcon": "build/installerHeaderIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    },
    "files": [
      "main.js",
      "server/**/*",
      "client/dist/**/*",
      "!server/user_data.db*",
      "!server/cache/**/*"
    ]
  }
}
